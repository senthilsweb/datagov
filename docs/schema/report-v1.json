{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Report",
  "description": "The canonical `datagov` report envelope (PRD §23).",
  "type": "object",
  "required": [
    "run",
    "schema_version",
    "summary",
    "tool"
  ],
  "properties": {
    "dataset": {
      "anyOf": [
        {
          "$ref": "#/definitions/DatasetSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/definitions/EvidenceSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/definitions/Input"
        },
        {
          "type": "null"
        }
      ]
    },
    "lineage": {
      "anyOf": [
        {
          "$ref": "#/definitions/LineageSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "pii": {
      "anyOf": [
        {
          "$ref": "#/definitions/PiiSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/definitions/PolicySection"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/definitions/ProfileSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "quality": {
      "anyOf": [
        {
          "$ref": "#/definitions/QualitySection"
        },
        {
          "type": "null"
        }
      ]
    },
    "run": {
      "$ref": "#/definitions/Run"
    },
    "schema": {
      "anyOf": [
        {
          "$ref": "#/definitions/SchemaSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/definitions/Summary"
    },
    "tool": {
      "$ref": "#/definitions/Tool"
    }
  },
  "definitions": {
    "ColumnSchema": {
      "description": "One column's inferred name, type, and nullability.",
      "type": "object",
      "required": [
        "data_type",
        "name",
        "nullable"
      ],
      "properties": {
        "data_type": {
          "$ref": "#/definitions/DataType"
        },
        "name": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        }
      }
    },
    "DataType": {
      "description": "The narrowest data type a reader inferred for a column. See the per-format narrowing rules in `datagov_data` for how each variant is chosen (e.g. CSV narrows Boolean → Integer → Float → String; JSON uses the JSON value's own type, with `Mixed` when non-null occurrences disagree).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "boolean",
            "integer",
            "float",
            "string",
            "object",
            "array"
          ]
        },
        {
          "description": "Every occurrence of the column was null/absent — no type could be inferred.",
          "type": "string",
          "enum": [
            "null"
          ]
        },
        {
          "description": "Non-null occurrences disagreed on type (JSON/JSONL only).",
          "type": "string",
          "enum": [
            "mixed"
          ]
        }
      ]
    },
    "DatasetSection": {
      "description": "The `dataset` section (PRD §10.1): populated by `datagov inspect` (and reused by `profile`/`report` in later bolts) with everything learned about an input dataset without necessarily doing a full scan (Parquet metadata in particular is read without scanning row data).",
      "type": "object",
      "required": [
        "approx_memory_bytes",
        "column_count",
        "file_size_bytes",
        "format",
        "row_count",
        "sample_rows",
        "schema"
      ],
      "properties": {
        "approx_memory_bytes": {
          "description": "A real measurement from the same scan/metadata read used to populate the rest of this section — not a rough guess. See `datagov_data` reader docs for the exact per-format formula.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "column_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "file_size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "format": {
          "description": "Detected/declared format: `\"csv\"` | `\"tsv\"` | `\"json\"` | `\"jsonl\"` | `\"parquet\"`.",
          "type": "string"
        },
        "parquet": {
          "description": "`Some` only when `format == \"parquet\"`.",
          "anyOf": [
            {
              "$ref": "#/definitions/ParquetInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "row_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "sample_rows": {
          "description": "The first `DEFAULT_SAMPLE_ROWS` records in source order, already masked (sensitive columns per `crate::sensitivity::is_heuristically_sensitive` are replaced with the `Masked` rendering) — safe to emit as-is on every output surface.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ColumnSchema"
          }
        }
      }
    },
    "EvidenceSection": {
      "description": "Placeholder for the `evidence` section; populated starting Bolt 5.",
      "type": "object"
    },
    "Input": {
      "description": "Describes the input the command operated on.",
      "type": "object",
      "required": [
        "format",
        "uri"
      ],
      "properties": {
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "LineageSection": {
      "description": "Placeholder for the `lineage` section; populated in a later change.",
      "type": "object"
    },
    "ParquetInfo": {
      "description": "Parquet-specific inspection detail (PRD §10.1: row groups, compression), read entirely from file metadata.",
      "type": "object",
      "required": [
        "compression_codecs",
        "row_groups"
      ],
      "properties": {
        "compression_codecs": {
          "description": "Distinct codec names (e.g. `\"SNAPPY\"`), sorted.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "row_groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RowGroupInfo"
          }
        }
      }
    },
    "PiiSection": {
      "description": "Placeholder for the `pii` section; populated starting Bolt 5.",
      "type": "object"
    },
    "PolicySection": {
      "description": "Placeholder for the `policy` section; populated in a later change.",
      "type": "object"
    },
    "ProfileSection": {
      "description": "Placeholder for the `profile` section; populated starting Bolt 3.",
      "type": "object"
    },
    "QualitySection": {
      "description": "Placeholder for the `quality` section; populated in a later change.",
      "type": "object"
    },
    "RowGroupInfo": {
      "description": "Metadata for a single Parquet row group.",
      "type": "object",
      "required": [
        "compressed_size_bytes",
        "index",
        "row_count",
        "uncompressed_size_bytes"
      ],
      "properties": {
        "compressed_size_bytes": {
          "type": "integer",
          "format": "int64"
        },
        "index": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "row_count": {
          "type": "integer",
          "format": "int64"
        },
        "uncompressed_size_bytes": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "Run": {
      "description": "Run metadata: identity, timing.",
      "type": "object",
      "required": [
        "completed_at",
        "duration_ms",
        "id",
        "started_at"
      ],
      "properties": {
        "completed_at": {
          "description": "RFC 3339 timestamp.",
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "id": {
          "description": "UUIDv7 run identifier (time-ordered, unique per run).",
          "type": "string"
        },
        "started_at": {
          "description": "RFC 3339 timestamp.",
          "type": "string"
        }
      }
    },
    "SchemaSection": {
      "description": "Placeholder for the `schema` section; populated in a later change.",
      "type": "object"
    },
    "Status": {
      "description": "Overall run status.",
      "type": "string",
      "enum": [
        "success",
        "warning",
        "failed"
      ]
    },
    "Summary": {
      "description": "Aggregate counts summarizing the run.",
      "type": "object",
      "required": [
        "errors",
        "info",
        "status",
        "warnings"
      ],
      "properties": {
        "errors": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "info": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "status": {
          "$ref": "#/definitions/Status"
        },
        "warnings": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "Tool": {
      "description": "Identifies the tool that produced the report.",
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
